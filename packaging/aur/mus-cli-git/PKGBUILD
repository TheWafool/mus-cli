# Maintainer: TheWafool
pkgname=mus-cli-git
_pkgname=mus-cli
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="A polished terminal UI for yt-dlp: download music and video, search, and manage a queue (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/TheWafool/mus-cli"
license=('MIT')
depends=('yt-dlp' 'ffmpeg' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=('deno: full YouTube support in yt-dlp'
            'libnotify: desktop notifications'
            'wl-clipboard: Ctrl+V paste on Wayland'
            'xclip: Ctrl+V paste on X11'
            'xdg-utils: open download folders')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!lto')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  if git describe --tags >/dev/null 2>&1; then
    git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
  else
    printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  fi
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/mus-cli "$pkgdir/usr/bin/mus-cli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
